{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Desktop Knowledge Companion",
  "version": "0.1.0",
  "identifier": "io.github.j.desktopknowledgecompanion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "sh scripts/prepare-sidecar.sh && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Desktop Knowledge Companion",
        "width": 1120,
        "height": 760,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png"],
    "resources": {
      "sidecar-manifest.json": "sidecar-manifest.json"
    },
    "externalBin": ["binaries/knowledge-core"],
    "targets": ["nsis", "appimage", "deb"]
  }
}
